# Copy to .env (gitignored) and fill in the keys you have.
# Decided in Step 0 of docs/NEXT_STEPS.md. See docs/AGENTS.md section 2, "Model assignment".

# --- Provider credentials -------------------------------------------------------
# Gemini (Google AI Studio) - OpenAI-compatible endpoint:
#   https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=
# OpenRouter - https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# Optional: direct OpenAI
OPENAI_API_KEY=

# --- Per-role provider chains ---------------------------------------------------
# Format: comma-separated provider:model-id, tried left to right on timeout/error.
# The deterministic engine is always the implicit last resort (emits a `fallback` event).
# Use model ids exactly as your provider's dashboard lists them - free model ids get
# renamed/deprecated often, so don't copy ids from docs; check the dashboard.
#
# The seller speaks in every thread (~half of all calls in a run): put it on the
# largest, most reliable quota pool you have. Never split the seller across pools.
SELLER_LLM_CHAIN=gemini:<flash-model-id>

# Buyer agents are assigned by match rank: slot 1 = top-ranked candidate, etc.
# Two OpenRouter :free models likely share ONE account-level quota - check with:
#   curl -s https://openrouter.ai/api/v1/key -H "Authorization: Bearer $OPENROUTER_API_KEY"
BUYER_1_LLM_CHAIN=openrouter:<free-model-id-a>,gemini:<flash-lite-model-id>
BUYER_2_LLM_CHAIN=openrouter:<free-model-id-b>,gemini:<flash-lite-model-id>
BUYER_3_LLM_CHAIN=gemini:<flash-lite-model-id>,openrouter:<free-model-id-a>

# --- Pacing (set from YOUR account's actual limits, not remembered numbers) -----
# Requests per minute per provider; concurrent threads are paced against these.
GEMINI_RPM=
OPENROUTER_RPM=
OPENAI_RPM=

# --- Existing: used by the current deterministic-fallback dialogue paraphrase ---
# NEGOTIATION_LLM_MODEL=
