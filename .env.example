# Copy to .env (gitignored) and fill in the keys you have.
# Decided in Step 0 of docs/NEXT_STEPS.md. See docs/AGENTS.md section 2, "Model assignment".

# --- Provider credentials -------------------------------------------------------
# Gemini (Google AI Studio) - OpenAI-compatible endpoint:
#   https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=
# OpenRouter - https://openrouter.ai/api/v1
# Round 3 decision: DROPPED from every default chain below (too many connection
# errors/timeouts and upstream 429s on :free models in live concurrent runs). The
# provider is still fully supported by the code - set a key and add "openrouter:<model>"
# to any *_LLM_CHAIN below to use it again, no code change needed.
OPENROUTER_API_KEY=
# NVIDIA API catalog (build.nvidia.com, trial/prototyping use) - https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
# Optional: direct OpenAI
OPENAI_API_KEY=

# --- Provider aliases (R2-6): multiple keys per provider ------------------------
# A provider name "<base>_<n>" (e.g. openrouter_2, gemini_3) is an ALIAS: it reuses
# the base provider's URL and request quirks (reasoning_effort for Gemini, the
# thinking=false body for NVIDIA) but gets its OWN key. OpenRouter/NVIDIA aliases
# have independent key/account buckets. Gemini is different: Google applies limits
# per Cloud project, so Gemini aliases share pacing by default. Set
# GEMINI_QUOTA_SCOPE=key only when each key is verified to belong to a different
# project. Alias-specific limit values still use <ALIAS>_RPM / <ALIAS>_RPD.
# An alias whose key is empty is skipped in the chain without a call. The alias is
# recorded verbatim in event `model` fields, e.g. "gemini_2:<model>".
# OpenRouter limits are per key/account -> each alias needs its own key from a
# different account/API key to actually add quota. Gemini limits are per model per
# Google Cloud project. NVIDIA limits are per account/key.
# Round 3: only gemini_2/3 and nvidia_2/3 are used by default (OpenRouter dropped,
# see above) - the openrouter_2/3/4 aliases below are supported but unused by default.
GEMINI_2_API_KEY=
GEMINI_3_API_KEY=
NVIDIA_2_API_KEY=
NVIDIA_3_API_KEY=
# Supported but unused by default (R3-3) - fill in and add to a chain to re-enable.
OPENROUTER_2_API_KEY=
OPENROUTER_3_API_KEY=
OPENROUTER_4_API_KEY=

# --- Per-role provider chains ---------------------------------------------------
# Format: comma-separated provider:model-id, tried left to right on timeout/error.
# The deterministic engine is always the implicit last resort (emits a `fallback` event).
# Use model ids exactly as your provider's dashboard lists them - free model ids get
# renamed/deprecated often, so don't copy ids from docs; check the dashboard.
#
# Team default (smoke-tested 2026-09-12; revised in Round 3 to Gemini x3 + NVIDIA x3
# only - OpenRouter dropped from every chain, see the credentials section above).
# Chains split provider:model on the FIRST colon; a chain entry's provider may be
# a base name (gemini, nvidia) or an alias (gemini_2, nvidia_3, ...).
# Flash-Lite is the only default Gemini model because the verified project limits
# are 15 RPM / 250K TPM / 500 RPD. Other Gemini text models are only 5 RPM / 20 RPD.
# Alternate Gemini keys protect against a key restriction/authentication problem;
# NVIDIA remains a last network fallback because its trial endpoint can stall.
SELLER_LLM_CHAIN=gemini:gemini-3.1-flash-lite,gemini_2:gemini-3.1-flash-lite,gemini_3:gemini-3.1-flash-lite,nvidia:deepseek-ai/deepseek-v4-flash-0731

# Buyer agents are assigned by match rank: slot 1 = top-ranked candidate, etc.
BUYER_1_LLM_CHAIN=gemini_2:gemini-3.1-flash-lite,gemini_3:gemini-3.1-flash-lite,nvidia_2:deepseek-ai/deepseek-v4-flash-0731
BUYER_2_LLM_CHAIN=gemini_3:gemini-3.1-flash-lite,gemini_2:gemini-3.1-flash-lite,nvidia_3:deepseek-ai/deepseek-v4-flash-0731
BUYER_3_LLM_CHAIN=gemini:gemini-3.1-flash-lite,gemini_3:gemini-3.1-flash-lite,nvidia:deepseek-ai/deepseek-v4-flash-0731

# Provider quirks found in smoke tests:
# - gemini-3.5-flash thinks by default and can exhaust max_tokens before answering;
#   send reasoning_effort (low is enough for JSON moves).
# - NVIDIA DeepSeek: send chat_template_kwargs.thinking=false, same reason. Its trial
#   endpoint stalled >40s on 3 of 7 test calls - keep it as a fallback, never a primary,
#   and see NVIDIA_TIMEOUT_S below (R3-4) for faster fallthrough on a stall.
GEMINI_REASONING_EFFORT=low

# --- Pacing / timeouts ----------------------------------------------------------
# Gemini limits are PER MODEL (AI Studio, checked 2026-09-12); OpenRouter free limits
# are account-wide across all :free models per key; NVIDIA per account/key.
# Format: model-id:limit,... The runtime paces to RPM and skips a model near its RPD.
# These are the BASE provider limits; an alias (gemini_3, nvidia_2, ...) inherits
# them automatically unless you set its own <ALIAS>_RPM / <ALIAS>_RPD (R2-6).
# Operational caps leave a little headroom below the dashboard's hard limits.
GEMINI_QUOTA_SCOPE=project
GEMINI_RPM=gemini-3.1-flash-lite:14,gemini-3.5-flash:4,gemini-3-flash-preview:4
GEMINI_RPD=gemini-3.1-flash-lite:480,gemini-3.5-flash:18,gemini-3-flash-preview:18
NVIDIA_RPM=40
# Supported but unused by default (R3-3 - OpenRouter dropped from every chain above).
OPENROUTER_RPM=20
# 50/day until $10 of credits is ever purchased, then 1000/day.
OPENROUTER_RPD=50

# Per-call timeout, in seconds, overridable PER BASE PROVIDER (<BASE>_TIMEOUT_S);
# an alias (nvidia_2, nvidia_3, ...) always inherits its base's value, never sets
# its own. Defaults to the global LLM_TIMEOUT_S (20s, in code) when unset. NVIDIA's
# trial endpoint stalls >40s on some calls, so a shorter timeout here lets a stalled
# call advance to the next chain entry sooner instead of waiting the full 20s - the
# deterministic fallback only fires once the WHOLE chain has failed (R3-4).
GEMINI_TIMEOUT_S=12
NVIDIA_TIMEOUT_S=8

# A 429 whose body names the OpenRouter free-tier daily bucket (free-models-per-day /
# openrouter_free_tier_daily) marks that ALIAS's whole key exhausted (account-wide)
# until X-RateLimit-Reset, persisted to runs/.quota.json (gitignored) so separate
# processes (tests, CLI runs) share it - R2-4. Dormant while OpenRouter is unused
# (R3-3) but still active code, so it applies again the moment a chain re-adds it.
# Override the quota file path with NEGOTIATION_QUOTA_FILE (tests point it at a
# throwaway file so they never touch runs/).

# --- Existing: used by the current deterministic-fallback dialogue paraphrase ---
# NEGOTIATION_LLM_MODEL=
