# Copy to .env (gitignored) and fill in the keys you have.
# Decided in Step 0 of docs/NEXT_STEPS.md. See docs/AGENTS.md section 2, "Model assignment".

# --- Provider credentials -------------------------------------------------------
# Gemini (Google AI Studio) - OpenAI-compatible endpoint:
#   https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=
# OpenRouter - https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# NVIDIA API catalog (build.nvidia.com, trial/prototyping use) - https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
# Optional: direct OpenAI
OPENAI_API_KEY=

# --- Per-role provider chains ---------------------------------------------------
# Format: comma-separated provider:model-id, tried left to right on timeout/error.
# The deterministic engine is always the implicit last resort (emits a `fallback` event).
# Use model ids exactly as your provider's dashboard lists them - free model ids get
# renamed/deprecated often, so don't copy ids from docs; check the dashboard.
#
# The seller speaks in every thread (~half of all calls in a run): put it on the
# largest, most reliable quota pool you have. Never split the seller across pools.
# Team default (smoke-tested 2026-09-12). Chains split provider:model on the FIRST colon.
SELLER_LLM_CHAIN=gemini:gemini-3.5-flash,gemini:gemini-3-flash-preview,nvidia:deepseek-ai/deepseek-v4-flash-0731

# Buyer agents are assigned by match rank: slot 1 = top-ranked candidate, etc.
# OpenRouter :free limits are ACCOUNT-WIDE, shared by every free model and key
# (confirmed 2026-09-12, openrouter.ai/docs/api-reference/limits): 20 req/min;
# 50 req/day if under $10 of credits ever purchased, 1000 req/day once $10 is bought.
# Check your account: curl -s https://openrouter.ai/api/v1/key -H "Authorization: Bearer <key>"
BUYER_1_LLM_CHAIN=openrouter:nex-agi/nex-n2.5-pro:free,gemini:gemini-3.1-flash-lite
BUYER_2_LLM_CHAIN=openrouter:nvidia/nemotron-3-super-120b-a12b:free,nvidia:deepseek-ai/deepseek-v4-flash-0731
BUYER_3_LLM_CHAIN=gemini:gemini-3.1-flash-lite,openrouter:google/gemma-4-31b-it:free

# Provider quirks found in smoke tests:
# - gemini-3.5-flash thinks by default and can exhaust max_tokens before answering;
#   send reasoning_effort (low is enough for JSON moves).
# - NVIDIA DeepSeek: send chat_template_kwargs.thinking=false, same reason. Its trial
#   endpoint stalled >40s on 3 of 7 test calls - keep it as a fallback, never a primary.
GEMINI_REASONING_EFFORT=low

# --- Pacing (set from YOUR account's actual limits, not remembered numbers) -----
# Requests per minute per provider; concurrent threads are paced against these.
GEMINI_RPM=
OPENROUTER_RPM=20
NVIDIA_RPM=
OPENAI_RPM=

# --- Existing: used by the current deterministic-fallback dialogue paraphrase ---
# NEGOTIATION_LLM_MODEL=
